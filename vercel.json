{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/prices",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/news",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/contracts",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/metrics",
      "schedule": "0 13 * * *"
    }
  ]
}
